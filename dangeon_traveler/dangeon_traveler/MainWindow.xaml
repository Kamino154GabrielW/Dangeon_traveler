<Window x:Class="dangeon_traveler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dangeon_traveler"
        mc:Ignorable="d"
        Title="MainWindow" Height="515" Width="860">
    <Grid Background="#FFBABB73">
        <Rectangle HorizontalAlignment="Left" Height="141" Margin="268,8,0,0" Stroke="Black" VerticalAlignment="Top" Width="304" RenderTransformOrigin="0.46,0.481"/>
        <Label x:Name="Enemie_HP_label" Content="HP  000/000" HorizontalAlignment="Left" Margin="346,154,0,0" VerticalAlignment="Top" Width="162" FontSize="25" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Label Content="Atack:005" HorizontalAlignment="Left" Margin="577,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.526,0.482" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Label Content="iniciative:1" HorizontalAlignment="Left" Margin="573,119,0,0" VerticalAlignment="Top" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Label Content="defence:001" HorizontalAlignment="Left" Margin="573,62,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.58,0.521" Width="121" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Label x:Name="Enemie_name_label" Content="enemie" HorizontalAlignment="Right" Margin="0,10,592,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="25" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Label x:Name="amount_of_enemies" Content="enemies:01/01" HorizontalAlignment="Left" Margin="137,116,0,0" VerticalAlignment="Top" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Rectangle HorizontalAlignment="Center" Height="41" Margin="0,321,0,0" Stroke="Black" VerticalAlignment="Top" Width="840"/>
        <Label x:Name="player_HP_label" Content="HP:000/000" HorizontalAlignment="Left" Margin="346,316,0,0" VerticalAlignment="Top" Width="188" FontSize="30" Height="52" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <Button x:Name="Atack_button" Content="Atack" HorizontalAlignment="Left" Margin="10,376,0,0" VerticalAlignment="Top" Height="56" Width="67" Click="Player_Atack_Button" MouseEnter="Atack_button_MouseEnter" FontSize="20" Background="#FF1E0F2B" Foreground="#FFC0E3FF" FontFamily="Comic Sans MS"/>
        <Button x:Name="Defend_button" Content="Defend" HorizontalAlignment="Left" Margin="102,376,0,0" VerticalAlignment="Top" Height="56" Width="75" Click="Player_Defend_Button" MouseEnter="Defend_button_MouseEnter" FontSize="20" Foreground="#FFC0E3FF" Background="#FF1E0F2B" FontFamily="Comic Sans MS"/>
        <Button x:Name="Skip_button" Content="Skip turn" HorizontalAlignment="Left" Margin="200,377,0,0" VerticalAlignment="Top" Height="54" Width="125" Click="Player_Skip_Button" MouseEnter="Skip_button_MouseEnter" FontSize="20" Background="#FF1E0F2B" Foreground="#FFC0E3FF" FontFamily="Comic Sans MS"/>
        <Label Content="iniciative:1" HorizontalAlignment="Left" Margin="757,424,0,0" VerticalAlignment="Top" FontSize="15" Foreground="#FF382373" FontWeight="Bold" FontFamily="Comic Sans MS"/>
        <Label Content="Atack:005" HorizontalAlignment="Left" Margin="764,362,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.526,0.482" FontSize="15" Foreground="#FF382373" FontWeight="Bold" FontFamily="Comic Sans MS"/>
        <Label Content="defence:002" HorizontalAlignment="Left" Margin="747,394,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.58,0.521" Width="103" FontSize="15" Foreground="#FF382373" FontWeight="Bold" FontFamily="Comic Sans MS"/>
        <Label x:Name="player_DFP_label" Content="DFP:000" HorizontalAlignment="Center" Margin="0,367,0,0" VerticalAlignment="Top" Width="108" RenderTransformOrigin="0.48,0.561" FontSize="20" Foreground="#FF382373" FontWeight="Bold" FontFamily="Comic Sans MS"/>
        <Label x:Name="Enemie_DFP_label" Content="DFP:000" HorizontalAlignment="Left" Margin="494,191,0,0" VerticalAlignment="Top" Width="83" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>
        <TextBlock x:Name="wnik_akcji_label" HorizontalAlignment="Left" Margin="146,245,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="565" Height="54" Background="#FF1E0F2B" Foreground="#FFC0E3FF" Padding="10,5,10,5"/>
        <Label x:Name="Enemie_Shield_label" Content="Shild:000" HorizontalAlignment="Left" Margin="268,191,0,0" VerticalAlignment="Top" Width="95" FontSize="18" Foreground="#FF382373" FontFamily="Comic Sans MS"/>

    </Grid>
</Window>
